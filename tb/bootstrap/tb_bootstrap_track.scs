// tb_bootstrap_track: differential tracking linearity with the reference switch
// @RNL(type="header") {
//   @VERSION("0.3");
//   @USE-PACKAGE(name="adc28", version="0.1", path="../../design/rnl/adc28.rnl")
// }
// generated by `python -m adcflow gen` from specs/ -- do not edit (tools/adcflow/gen_tb.py)
// Globals vdd, vdd18, tempc, noise_en, devnoise, beh_speed, vref_in come from the run deck.
simulator lang=spectre
parameters fin=49.8046875e6 amp_dbfs=-1 npts=256 nskip=4 tper=10n fs_peak=0.9987 vcm_in=0.45 rsrc=50 wsw=48u cs=1.0235p
parameters amp=fs_peak*pow(10, amp_dbfs/20) tstart=nskip*tper tstop=(nskip+npts+0.5)*tper
XBSP (VINP PHI_B PHI_BB VGP AVDD 0) adc_bootstrap
XBSN (VINN PHI_B PHI_BB VGN AVDD 0) adc_bootstrap
VSP (SRCP 0) vsource type=sine sinedc=vcm_in ampl=amp/2 freq=fin
VSN (SRCN 0) vsource type=sine sinedc=vcm_in ampl=-amp/2 freq=fin
RSP (SRCP VINP) resistor r=rsrc
RSN (SRCN VINN) resistor r=rsrc
// bottom-plate voltages at the PHI_S falling edges
ISMP (BPP BPN PHI_S 0) tb_sampler_va dir=-1 delay=0 tstart=tstart fname="samples.txt"
// reference input switch of one CDAC side
MSWP (BPP VGP VINP 0) nch_ulvt_mac w=wsw l=30n nf=24
CSP (BPP TOPRP) capacitor c=cs
STOPP (TOPRP VCM PHI_S 0) relay vt1=0.35 vt2=0.55 ropen=1e12 rclosed=20
CVGP (VGP 0) capacitor c=10f
// reference input switch of one CDAC side
MSWN (BPN VGN VINN 0) nch_ulvt_mac w=wsw l=30n nf=24
CSN (BPN TOPRN) capacitor c=cs
STOPN (TOPRN VCM PHI_S 0) relay vt1=0.35 vt2=0.55 ropen=1e12 rclosed=20
CVGN (VGN 0) capacitor c=10f
VCLK (CLK 0) vsource type=pulse val0=0 val1=vdd period=tper width=tper/2-20p rise=20p fall=20p
// ideal sampling phases
ICG (CLK PHI_S PHI_SB PHI_B PHI_BB CONV VDDA 0) adc_clkgen_va
VDDA (VDDA 0) vsource dc=vdd
VVCM (VCM 0) vsource dc=vref_in/2
VAVDD (AVDD 0) vsource dc=vdd
tran1 tran stop=tstop outputstart=tstop
tbopts options save=none reltol=1e-5 vabstol=1e-8
