// tb_clkgen_jitter: PHI_S falling-edge jitter with transient noise
// @RNL(type="header") {
//   @VERSION("0.3");
//   @USE-PACKAGE(name="adc28", version="0.1", path="../../design/rnl/adc28.rnl")
// }
// generated by `python -m adcflow gen` from specs/ -- do not edit (tools/adcflow/gen_tb.py)
// Globals vdd, vdd18, tempc, noise_en, devnoise, beh_speed, vref_in come from the run deck.
simulator lang=spectre
parameters ncyc=200 nfmax=50G
parameters tstop=(ncyc+1)*10n
XDUT (CLK PHI_S PHI_SB PHI_B PHI_BB CONV AVDD 0) adc_clkgen
VCLK (CLK 0) vsource type=pulse val0=0 val1=vdd period=10n width=4.98n rise=20p fall=20p
// time of every PHI_S falling crossing
ISMP (PHI_S 0 PHI_S 0) tb_sampler_va vth=vdd/2 dir=-1 delay=0 tstart=10n fname="edges.txt"
CLPHI_S (PHI_S 0) capacitor c=60f
CLPHI_SB (PHI_SB 0) capacitor c=60f
CLPHI_B (PHI_B 0) capacitor c=40f
CLPHI_BB (PHI_BB 0) capacitor c=40f
CLCONV (CONV 0) capacitor c=250f
VAVDD (AVDD 0) vsource dc=vdd
tran1 tran stop=tstop noisefmax=nfmax*noise_en*devnoise noiseseed=1 outputstart=tstop
tbopts options save=none
