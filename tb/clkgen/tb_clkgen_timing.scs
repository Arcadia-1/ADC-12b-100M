// tb_clkgen_timing: phase order, delays, skews and edge rates
// @RNL(type="header") {
//   @VERSION("0.3");
//   @USE-PACKAGE(name="adc28", version="0.1", path="../../design/rnl/adc28.rnl")
// }
// generated by `python -m adcflow gen` from specs/ -- do not edit (tools/adcflow/gen_tb.py)
// Globals vdd, vdd18, tempc, noise_en, devnoise, beh_speed, vref_in come from the run deck.
simulator lang=spectre
parameters tstop=161n
XDUT (CLK PHI_S PHI_SB PHI_B PHI_BB CONV AVDD 0) adc_clkgen
// 8 cycles at 50 % duty, 4 at 45 %, 4 at 55 % (20 ps edges)
VCLK (CLK 0) vsource type=pwl wave=[0.0000e+00 0 1.0000e-09 0 1.0200e-09 vdd 6.0000e-09 vdd 6.0200e-09 0 1.1000e-08 0 1.1020e-08 vdd 1.6000e-08 vdd 1.6020e-08 0 2.1000e-08 0 2.1020e-08 vdd 2.6000e-08 vdd 2.6020e-08 0 3.1000e-08 0 3.1020e-08 vdd 3.6000e-08 vdd 3.6020e-08 0 4.1000e-08 0 4.1020e-08 vdd 4.6000e-08 vdd 4.6020e-08 0 5.1000e-08 0 5.1020e-08 vdd 5.6000e-08 vdd 5.6020e-08 0 6.1000e-08 0 6.1020e-08 vdd 6.6000e-08 vdd 6.6020e-08 0 7.1000e-08 0 7.1020e-08 vdd 7.6000e-08 vdd 7.6020e-08 0 8.1000e-08 0 8.1020e-08 vdd 8.5500e-08 vdd 8.5520e-08 0 9.1000e-08 0 9.1020e-08 vdd 9.5500e-08 vdd 9.5520e-08 0 1.0100e-07 0 1.0102e-07 vdd 1.0550e-07 vdd 1.0552e-07 0 1.1100e-07 0 1.1102e-07 vdd 1.1550e-07 vdd 1.1552e-07 0 1.2100e-07 0 1.2102e-07 vdd 1.2650e-07 vdd 1.2652e-07 0 1.3100e-07 0 1.3102e-07 vdd 1.3650e-07 vdd 1.3652e-07 0 1.4100e-07 0 1.4102e-07 vdd 1.4650e-07 vdd 1.4652e-07 0 1.5100e-07 0 1.5102e-07 vdd 1.5650e-07 vdd 1.5652e-07 0]
CLPHI_S (PHI_S 0) capacitor c=60f
CLPHI_SB (PHI_SB 0) capacitor c=60f
CLPHI_B (PHI_B 0) capacitor c=40f
CLPHI_BB (PHI_BB 0) capacitor c=40f
CLCONV (CONV 0) capacitor c=250f
VAVDD (AVDD_S 0) vsource dc=vdd
IMAVDD (AVDD_S AVDD) tb_imeter_va tstart=10n tstop=80n label="AVDD" fname="power.txt"
tran1 tran stop=tstop maxstep=2p
save CLK PHI_S PHI_SB PHI_B PHI_BB CONV
