// tb_comp_noise: input-referred noise and offset from P(OUTP) vs vd
// @RNL(type="header") {
//   @VERSION("0.3");
//   @USE-PACKAGE(name="adc28", version="0.1", path="../../design/rnl/adc28.rnl")
// }
// generated by `python -m adcflow gen` from specs/ -- do not edit (tools/adcflow/gen_tb.py)
// Globals vdd, vdd18, tempc, noise_en, devnoise, beh_speed, vref_in come from the run deck.
simulator lang=spectre
parameters cload=10f nfmax=50G
parameters tstop=3.329e-07
XDUT (INP INN CLKC OUTP OUTN AVDD 0) adc_comp
VDP (INP 0) vsource type=pwl wave=[0.0000e+00 0.48985 2.5590e-08 0.48985 2.5600e-08 0.489875 5.1190e-08 0.489875 5.1200e-08 0.4899 7.6790e-08 0.4899 7.6800e-08 0.489925 1.0239e-07 0.489925 1.0240e-07 0.48995 1.2799e-07 0.48995 1.2800e-07 0.489975 1.5359e-07 0.489975 1.5360e-07 0.49 1.7919e-07 0.49 1.7920e-07 0.490025 2.0479e-07 0.490025 2.0480e-07 0.49005 2.3039e-07 0.49005 2.3040e-07 0.490075 2.5599e-07 0.490075 2.5600e-07 0.4901 2.8159e-07 0.4901 2.8160e-07 0.490125 3.0719e-07 0.490125 3.0720e-07 0.49015]
VDN (INN 0) vsource type=pwl wave=[0.0000e+00 0.49015 2.5590e-08 0.49015 2.5600e-08 0.490125 5.1190e-08 0.490125 5.1200e-08 0.4901 7.6790e-08 0.4901 7.6800e-08 0.490075 1.0239e-07 0.490075 1.0240e-07 0.49005 1.2799e-07 0.49005 1.2800e-07 0.490025 1.5359e-07 0.490025 1.5360e-07 0.49 1.7919e-07 0.49 1.7920e-07 0.489975 2.0479e-07 0.489975 2.0480e-07 0.48995 2.3039e-07 0.48995 2.3040e-07 0.489925 2.5599e-07 0.489925 2.5600e-07 0.4899 2.8159e-07 0.4899 2.8160e-07 0.489875 3.0719e-07 0.489875 3.0720e-07 0.48985]
VCK (CLKC 0) vsource type=pulse val0=0 val1=vdd period=4e-10 delay=100p width=1.9e-10 rise=10p fall=10p
COP (OUTP 0) capacitor c=cload
CON (OUTN 0) capacitor c=cload
// decision of every cycle, sampled when CLKC falls
ISMP (OUTP OUTN CLKC 0) tb_sampler_va vth=vdd/2 dir=-1 delay=0 fname="decisions.txt"
VAVDD (AVDD 0) vsource dc=vdd
tran1 tran stop=tstop noisefmax=nfmax*noise_en*devnoise noiseseed=1 outputstart=tstop
tbopts options save=none
