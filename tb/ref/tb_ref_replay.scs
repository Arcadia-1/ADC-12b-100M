// tb_ref_replay: VREFP under the CDAC charge sequence of a near-Nyquist conversion
// @RNL(type="header") {
//   @VERSION("0.3");
//   @USE-PACKAGE(name="adc28", version="0.1", path="../../design/rnl/adc28.rnl")
// }
// generated by `python -m adcflow gen` from specs/ -- do not edit (tools/adcflow/gen_tb.py)
// Globals vdd, vdd18, tempc, noise_en, devnoise, beh_speed, vref_in come from the run deck.
simulator lang=spectre
parameters npts=1024 nwarm=32 fin=48.828125e6 ccdac=0.6p
parameters tstop=(nwarm+npts+2)*10n
XDUT (VREF_IN VREFP VCM AVDD18 AVDD 0) adc_ref
VREF (VREF_IN 0) vsource dc=vref_in
VH (AVDD18 0) vsource dc=vdd18
VA (AVDD 0) vsource dc=vdd
// CDAC bottom plates seen from VREFP (both sides)
CDB (VREFP 0) capacitor c=ccdac
// CDAC charge per conversion from the system model: start + 13 switch pulses
ILD (VREFP 0) isource type=pwl file="iload.pwl"
// toggles at the comparator clock of every decision and just before each start
VTRIG (TRIG 0) vsource type=pwl file="trig.pwl"
// VREFP at every toggle
ISMP (VREFP 0 TRIG 0) tb_sampler_va vth=0.5 dir=0 delay=0 fname="vdec.txt"
tran1 tran stop=tstop outputstart=tstop
tbopts options save=none
