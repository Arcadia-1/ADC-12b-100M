// tb_cdac_settle: DAC step settling, conversion start, hold droop, VREFP charge
// @RNL(type="header") {
//   @VERSION("0.3");
//   @USE-PACKAGE(name="adc28", version="0.1", path="../../design/rnl/adc28.rnl")
// }
// generated by `python -m adcflow gen` from specs/ -- do not edit (tools/adcflow/gen_tb.py)
// Globals vdd, vdd18, tempc, noise_en, devnoise, beh_speed, vref_in come from the run deck.
simulator lang=spectre
parameters tper=10n ctop=15f
parameters tstop=7*tper
// DH5 of the DUT is driven by VDH5 (AC source for the control input capacitance)
XDUT (VIN VG TOP VCM VREFP 0 PHI_S PHI_SB CONV DH12 DH11 DH10 DH9 DH8 DH7 DH6 DH5X DH4 DH3 \
        DH2 DH1 DH0 RL12 RL11 RL10 RL9 RL8 RL7 RL6 RL5 RL4 RL3 RL2 RL1 RL0 VDDA 0) adc_cdac
VVIN (VIN 0) vsource dc=0.45
VDH5 (DH5X 0) vsource dc=0 mag=1
CTOP (TOP 0) capacitor c=ctop
IBS (VIN PHI_B PHI_BB VG VDDA 0) adc_bootstrap_va kboost=1
// conv 3: RL12, conv 4: RL5, conv 5: RL0 at 1 ns; conv 6: RL12..RL0 every 150 ps
ISEQ (CONV DH12 DH11 DH10 DH9 DH8 DH7 DH6 DH5 DH4 DH3 DH2 DH1 DH0 RL12 RL11 RL10 RL9 RL8 RL7 \
        RL6 RL5 RL4 RL3 RL2 RL1 RL0 VDDA 0) tb_cdac_seq_va mode=1 n0=3 sel0=1 sel1=15 sel2=25
VREFP (VREFP_S 0) vsource dc=vref_in
// VREFP charge over cycle 6 (track + full conversion)
IMREF (VREFP_S VREFP) tb_imeter_va tstart=5n*11-0.2n tstop=5n*13-0.2n label="VREFP" fname="qref.txt"
VCLK (CLK 0) vsource type=pulse val0=0 val1=vdd period=tper width=tper/2-20p rise=20p fall=20p
// ideal sampling phases
ICG (CLK PHI_S PHI_SB PHI_B PHI_BB CONV VDDA 0) adc_clkgen_va
VDDA (VDDA 0) vsource dc=vdd
VVCM (VCM 0) vsource dc=vref_in/2
tran1 tran stop=tstop maxstep=2p
ac1 ac freq=100M
save TOP CONV VDH5:p
