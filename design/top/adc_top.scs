// adc_top: 12-bit-class 100 MS/s asynchronous SAR ADC, structural top level
// @RNL(type="header") {
//   @VERSION("0.3");
//   @USE-PACKAGE(name="adc28", version="0.1", path="../rnl/adc28.rnl")
// }
// generated by `python -m adcflow gen` from specs/ -- do not edit (tools/adcflow/gen_top.py)
// The same file is used with any mix of block views (behav / xtor).
simulator lang=spectre

subckt adc_top (VINP VINN CLK VREF_IN \
        D13 D12 D11 D10 D9 D8 D7 D6 D5 D4 D3 D2 D1 D0 RDY \
        AVDD DVDD AVDD18 VSS)
// reference driver and sampling phases
XREF (VREF_IN VREFP VCM AVDD18 AVDD VSS) adc_ref
XCLK (CLK PHI_S PHI_SB PHI_B PHI_BB CONV AVDD VSS) adc_clkgen
// bottom-plate sampling front end (P side: DH = DN, RL = UP; N side: DH = UP, RL = DN)
XBSP (VINP PHI_B PHI_BB VGP AVDD VSS) adc_bootstrap
XBSN (VINN PHI_B PHI_BB VGN AVDD VSS) adc_bootstrap
XDACP (VINP VGP TOPP VCM VREFP VSS PHI_S PHI_SB CONV DN12 DN11 DN10 DN9 DN8 DN7 DN6 DN5 DN4 \
        DN3 DN2 DN1 DN0 UP12 UP11 UP10 UP9 UP8 UP7 UP6 UP5 UP4 UP3 UP2 UP1 UP0 DVDD VSS) adc_cdac
XDACN (VINN VGN TOPN VCM VREFP VSS PHI_S PHI_SB CONV UP12 UP11 UP10 UP9 UP8 UP7 UP6 UP5 UP4 \
        UP3 UP2 UP1 UP0 DN12 DN11 DN10 DN9 DN8 DN7 DN6 DN5 DN4 DN3 DN2 DN1 DN0 DVDD VSS) adc_cdac
// comparator: INP <- TOPN, INN <- TOPP (the top plates are inverted), OUTP = 1 means UP
XCMP (TOPN TOPP CLKC OUTP OUTN AVDD VSS) adc_comp
XLOG (CONV OUTP OUTN CLKC UP12 UP11 UP10 UP9 UP8 UP7 UP6 UP5 UP4 UP3 UP2 UP1 UP0 DN12 DN11 \
        DN10 DN9 DN8 DN7 DN6 DN5 DN4 DN3 DN2 DN1 DN0 D13 D12 D11 D10 D9 D8 D7 D6 D5 D4 D3 D2 \
        D1 D0 RDY DVDD VSS) adc_sarlogic
