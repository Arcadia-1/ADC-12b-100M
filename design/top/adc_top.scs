//   %s6 = $SUPPLY @ATTACH &AVDD => @PLACE(-24, 45);
//   &AVDD @WIRE {#XBSP:AVDD %s6:p};
//   %g7 = $GROUND @ATTACH &VSS => @PLACE(-20, 31);
//   &VSS @WIRE {#XBSP:VSS %g7:p};
//   %s8 = $SUPPLY @ATTACH &AVDD => @PLACE(-24, -1);
//   &AVDD @WIRE {#XBSN:AVDD %s8:p};
//   %g9 = $GROUND @ATTACH &VSS => @PLACE(-20, -15);
//   &VSS @WIRE {#XBSN:VSS %g9:p};
//   %s10 = $SUPPLY @ATTACH &DVDD => @PLACE(19, 28);
//   &DVDD @WIRE {#XDACP:DVDD (12, 30) (12, 28) %s10:p};
