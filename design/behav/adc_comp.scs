//   (25.88, 3.9575) @TEXT("comparator clock from SAR logic; 0 = reset, 1 = evaluate", halign="start", valign="middle", size=0.55) => @SET-STYLE $table_style;
//   (16.5, 2.8025) @TEXT("OUTP", halign="start", valign="middle", size=0.55) => @SET-STYLE $table_style;
//   (18.776, 2.8025) @TEXT("output", halign="start", valign="middle", size=0.55) => @SET-STYLE $table_style;
//   (22.647, 2.8025) @TEXT("digital", halign="start", valign="middle", size=0.55) => @SET-STYLE $table_style;
//   (25.88, 2.8025) @TEXT("1 when INP > INN (return-to-zero)", halign="start", valign="middle", size=0.55) => @SET-STYLE $table_style;
//   (16.5, 1.6475) @TEXT("OUTN", halign="start", valign="middle", size=0.55) => @SET-STYLE $table_style;
//   (18.776, 1.6475) @TEXT("output", halign="start", valign="middle", size=0.55) => @SET-STYLE $table_style;
