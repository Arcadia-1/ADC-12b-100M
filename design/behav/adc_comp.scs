//   (18.776, 0.4925) @TEXT("inout", halign="start", valign="middle", size=0.55) => @SET-STYLE $table_style;
//   (22.647, 0.4925) @TEXT("supply", halign="start", valign="middle", size=0.55) => @SET-STYLE $table_style;
//   (25.88, 0.4925) @TEXT("0.9 V analog supply", halign="start", valign="middle", size=0.55) => @SET-STYLE $table_style;
//   (16.5, -0.6625) @TEXT("VSS", halign="start", valign="middle", size=0.55) => @SET-STYLE $table_style;
//   (18.776, -0.6625) @TEXT("inout", halign="start", valign="middle", size=0.55) => @SET-STYLE $table_style;
//   (22.647, -0.6625) @TEXT("ground", halign="start", valign="middle", size=0.55) => @SET-STYLE $table_style;
//   (25.88, -0.6625) @TEXT("ground", halign="start", valign="middle", size=0.55) => @SET-STYLE $table_style
