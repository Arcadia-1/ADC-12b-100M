//   &VSS @ADD-TO $GROUND_NET_SET;
//   /* --- placement and wires --- */
//   #I0 @PLACE(0, 0);
//   %p_clk = $IO_PORT @ATTACH &CLK => @PLACE(-10, 0) => @ORIENT("R0");
//   &CLK @WIRE {%p_clk:p #I0:CLK};
//   %p_phi_s = $IO_PORT @ATTACH &PHI_S => @PLACE(10, 4) => @ORIENT("MY");
//   &PHI_S @WIRE {#I0:PHI_S %p_phi_s:p};
//   %p_phi_sb = $IO_PORT @ATTACH &PHI_SB => @PLACE(10, 2) => @ORIENT("MY");
//   &PHI_SB @WIRE {#I0:PHI_SB %p_phi_sb:p};
//   %p_phi_b = $IO_PORT @ATTACH &PHI_B => @PLACE(10, 0) => @ORIENT("MY");
//   &PHI_B @WIRE {#I0:PHI_B %p_phi_b:p};
//   %p_phi_bb = $IO_PORT @ATTACH &PHI_BB => @PLACE(10, -2) => @ORIENT("MY");
//   &PHI_BB @WIRE {#I0:PHI_BB %p_phi_bb:p};
//   %p_conv = $IO_PORT @ATTACH &CONV => @PLACE(10, -4) => @ORIENT("MY");
//   &CONV @WIRE {#I0:CONV %p_conv:p};
//   %s1 = $SUPPLY @ATTACH &AVDD => @PLACE(0, 9);
//   &AVDD @WIRE {#I0:AVDD %s1:p};
//   %g1 = $GROUND @ATTACH &VSS => @PLACE(0, -9);
//   &VSS @WIRE {#I0:VSS %g1:p};
//   /* --- annotations --- */
//   (-12, 15.5) @TEXT("adc_clkgen (behavioral): CLK fall -> PHI_S fall -> PHI_B fall -> CONV rise", halign="start") => @SET-STYLE $title_style;
//   (-12, 14) @TEXT("CLK rise -> CONV fall -> PHI_B, PHI_S rise (break before make); delays scaled by beh_speed", halign="start") => @SET-STYLE $note_style
// }
ends adc_clkgen
