//   &VSS @WIRE {#CCM:2 %g2:p};
//   %s1 = $SUPPLY @ATTACH &AVDD18 => @PLACE(-2, 6);
//   &AVDD18 @WIRE {#I0:AVDD18 %s1:p};
//   %s2 = $SUPPLY @ATTACH &AVDD => @PLACE(2, 6);
