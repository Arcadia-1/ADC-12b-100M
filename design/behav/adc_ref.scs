// adc_ref, behavioral view: reference driver and VCM
// @RNL(type="header") {
//   @VERSION("0.3");
//   @USE-PACKAGE(name="adc28", version="0.1", path="../rnl/adc28.rnl")
// }
simulator lang=spectre

subckt adc_ref (VREF_IN VREFP VCM AVDD18 AVDD VSS)
// Behavioral view.
parameters cdec=2n esr=0.5 ccm=100p rout=1 fbw=50M iq18=150u iq09=5u
I0 (VREF_IN VREFP VCM AVDD18 AVDD VSS) adc_ref_va \
        rout=rout fbw=fbw iq18=iq18 iq09=iq09
CDEC (VREFP NDEC) capacitor c=cdec
RESR (NDEC VSS) resistor r=esr
CCM (VCM VSS) capacitor c=ccm
