// adc_cdac, behavioral view: one side of the split-capacitor redundant CDAC
// @RNL(type="header") {
//   @VERSION("0.3");
//   @USE-PACKAGE(name="adc28", version="0.1", path="../rnl/adc28.rnl")
// }
// generated by `python -m adcflow gen` from specs/ -- do not edit (specs/arch.yaml, cdac section)
// Uses the deck globals noise_en and tempc.
simulator lang=spectre

subckt adc_cdac (VIN VG TOP VCM VREFP VREFN PHI_S PHI_SB CONV \
        DH12 DH11 DH10 DH9 DH8 DH7 DH6 DH5 DH4 DH3 DH2 DH1 DH0 \
        RL12 RL11 RL10 RL9 RL8 RL7 RL6 RL5 RL4 RL3 RL2 RL1 RL0 DVDD VSS)
parameters cu=5e-16 cp_ratio=0.1 ron_in=25 tau_drv=12p ron_top=20
// input switches (gate VG), tri-state VREFP/VREFN drivers, neutral states
ISW (VIN VG VREFP VREFN CONV \
        DH12 DH11 DH10 DH9 DH8 DH7 DH6 DH5 DH4 DH3 DH2 DH1 DH0 \
        RL12 RL11 RL10 RL9 RL8 RL7 RL6 RL5 RL4 RL3 RL2 RL1 RL0 \
        BH12 BL12 BH11 BL11 BH10 BL10 BH9 BL9 BH8 BL8 BH7 BL7 BH6 \
        BL6 BH5 BL5 BH4 BL4 BH3 BL3 BH2 BL2 BH1 BL1 BH0 BL0 VSS) adc_cdac_sw_va cu=cu ron_in=ron_in tau_drv=tau_drv
// capacitor array: weight w = two halves of w*cu/2 (H: neutral VREFP, L: neutral VREFN)
CH12 (BH12 TOP) capacitor c=512*cu
CL12 (BL12 TOP) capacitor c=512*cu
CH11 (BH11 TOP) capacitor c=256*cu
CL11 (BL11 TOP) capacitor c=256*cu
CH10 (BH10 TOP) capacitor c=128*cu
CL10 (BL10 TOP) capacitor c=128*cu
CH9 (BH9 TOP) capacitor c=96*cu
CL9 (BL9 TOP) capacitor c=96*cu
CH8 (BH8 TOP) capacitor c=64*cu
CL8 (BL8 TOP) capacitor c=64*cu
CH7 (BH7 TOP) capacitor c=32*cu
CL7 (BL7 TOP) capacitor c=32*cu
CH6 (BH6 TOP) capacitor c=16*cu
CL6 (BL6 TOP) capacitor c=16*cu
CH5 (BH5 TOP) capacitor c=16*cu
CL5 (BL5 TOP) capacitor c=16*cu
CH4 (BH4 TOP) capacitor c=8*cu
CL4 (BL4 TOP) capacitor c=8*cu
CH3 (BH3 TOP) capacitor c=4*cu
CL3 (BL3 TOP) capacitor c=4*cu
CH2 (BH2 TOP) capacitor c=2*cu
CL2 (BL2 TOP) capacitor c=2*cu
CH1 (BH1 TOP) capacitor c=1*cu
CL1 (BL1 TOP) capacitor c=1*cu
CH0 (BH0 TOP) capacitor c=0.5*cu
CL0 (BL0 TOP) capacitor c=0.5*cu
// top-plate parasitic: routing, switch junctions, comparator input
CP (TOP VSS) capacitor c=cp_ratio*2271*cu
// top-plate reset switch (PHI_S high = track) in series with the sampled kT/C source
STOP (TOP NK PHI_S VSS) relay vt1=0.35 vt2=0.55 ropen=1e12 rclosed=ron_top
IKTC (NK VCM PHI_S VSS) adc_ktc_va ctot=(1+cp_ratio)*2271*cu tempc=tempc en=noise_en
// @RNL {
//   /* --- semantics --- */
//   &VSS @ADD-TO $GROUND_NET_SET;
//   /* one array: every half is a matched multiple of the unit cu; each weight is an H/L pair */
//   {#CH12 #CL12 #CH11 #CL11 #CH10 #CL10 #CH9 #CL9 #CH8 #CL8 #CH7 #CL7 #CH6 #CL6 #CH5 #CL5 #CH4 #CL4 #CH3 #CL3 #CH2 #CL2 #CH1 #CL1 #CH0 #CL0} @AS $MATCHED;
//   {#CH12 #CL12} @AS $MATCHED;
//   {#CH12 #CL12} @GROUP;
//   {#CH11 #CL11} @AS $MATCHED;
//   {#CH11 #CL11} @GROUP;
//   {#CH10 #CL10} @AS $MATCHED;
//   {#CH10 #CL10} @GROUP;
//   {#CH9 #CL9} @AS $MATCHED;
//   {#CH9 #CL9} @GROUP;
//   {#CH8 #CL8} @AS $MATCHED;
//   {#CH8 #CL8} @GROUP;
//   {#CH7 #CL7} @AS $MATCHED;
//   {#CH7 #CL7} @GROUP;
//   {#CH6 #CL6} @AS $MATCHED;
//   {#CH6 #CL6} @GROUP;
//   {#CH5 #CL5} @AS $MATCHED;
//   {#CH5 #CL5} @GROUP;
//   {#CH4 #CL4} @AS $MATCHED;
//   {#CH4 #CL4} @GROUP;
//   {#CH3 #CL3} @AS $MATCHED;
//   {#CH3 #CL3} @GROUP;
//   {#CH2 #CL2} @AS $MATCHED;
//   {#CH2 #CL2} @GROUP;
//   {#CH1 #CL1} @AS $MATCHED;
//   {#CH1 #CL1} @GROUP;
//   {#CH0 #CL0} @AS $MATCHED;
//   {#CH0 #CL0} @GROUP;
//   /* the top plate: the array, its parasitic, the reset switch and the sampled kT/C noise */
//   {#CP #STOP #IKTC} @AS(direction="left-to-right") $FLOW;
//   /* --- placement: switch matrix at the bottom, each half above its bottom-plate pin --- */
//   #ISW @PLACE(0, 0);
//   #CH12 @PLACE(0, 13) => @ORIENT("MX");
//   #CL12 @PLACE(3, 13) => @ORIENT("MX");
//   #CH11 @PLACE(6, 13) => @ORIENT("MX");
//   #CL11 @PLACE(9, 13) => @ORIENT("MX");
