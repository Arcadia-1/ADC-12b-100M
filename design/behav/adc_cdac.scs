//   #CL9 @PLACE(21, 13) => @ORIENT("MX");
//   #CH8 @PLACE(24, 13) => @ORIENT("MX");
//   #CL8 @PLACE(27, 13) => @ORIENT("MX");
//   #CH7 @PLACE(30, 13) => @ORIENT("MX");
//   #CL7 @PLACE(33, 13) => @ORIENT("MX");
//   #CH6 @PLACE(36, 13) => @ORIENT("MX");
//   #CL6 @PLACE(39, 13) => @ORIENT("MX");
//   #CH5 @PLACE(42, 13) => @ORIENT("MX");
//   #CL5 @PLACE(45, 13) => @ORIENT("MX");
//   #CH4 @PLACE(48, 13) => @ORIENT("MX");
//   #CL4 @PLACE(51, 13) => @ORIENT("MX");
//   #CH3 @PLACE(54, 13) => @ORIENT("MX");
//   #CL3 @PLACE(57, 13) => @ORIENT("MX");
//   #CH2 @PLACE(60, 13) => @ORIENT("MX");
//   #CL2 @PLACE(63, 13) => @ORIENT("MX");
//   #CH1 @PLACE(66, 13) => @ORIENT("MX");
//   #CL1 @PLACE(69, 13) => @ORIENT("MX");
//   #CH0 @PLACE(72, 13) => @ORIENT("MX");
//   #CL0 @PLACE(75, 13) => @ORIENT("MX");
//   #CP @PLACE(84, 13);
//   #STOP @PLACE(94, 17);
//   #IKTC @PLACE(104, 9);
//   /* --- bottom plates --- */
//   &BH12 @WIRE {#ISW:BH12 #CH12:1};
//   &BL12 @WIRE {#ISW:BL12 #CL12:1};
