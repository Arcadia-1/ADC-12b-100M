    (-3, -4) @PIN(terminal=5, label="CONV", direction="left");
    @LINE {(-3, -4) (-2, -4)};
    (78, 0) @PIN(terminal=58, label="VSS", direction="right");
    @LINE {(77, 0) (78, 0)};
    ? @TEXT("adc_cdac_sw_va: input switches (gate VG) + tri-state VREFP/VREFN drivers", key="model", size=0.9) => @PLACE(37, 1);
    ? @TEXT("${name}", key="name", size=0.8) => @PLACE(37, -1.5)
  };

