  @DEVICE(name="*", model="adc_bootstrap_va", terminals=["VIN", "PHI_B", "PHI_BB", "VG", "AVDD", "VSS"]);
  @DEVICE(name="*", model="adc_ref_va", terminals=["VREF_IN", "VREFP", "VCM", "AVDD18", "AVDD", "VSS"]);
  @DEVICE(name="*", model="adc_ktc_va", terminals=["P", "N", "PHI", "VSS"]);
  @DEVICE(name="*", model="tb_capture_va", terminals=["CLK", "RDY", "D13", "D12", "D11", "D10", "D9", "D8", "D7", "D6", "D5", "D4", "D3", "D2", "D1", "D0", "VSS"]);
  @DEVICE(name="*", model="tb_imeter_va", terminals=["P", "N"]);
  @DEVICE(name="*", model="tb_sampler_va", terminals=["P", "N", "TRIG", "VSS"]);
  @DEVICE(name="*", model="tb_cmp_emu_va", terminals=["CONV", "CLKC", "UP12", "UP11", "UP10", "UP9", "UP8", "UP7", "UP6", "UP5", "UP4", "UP3", "UP2", "UP1", "UP0", "DN12", "DN11", "DN10", "DN9", "DN8", "DN7", "DN6", "DN5", "DN4", "DN3", "DN2", "DN1", "DN0", "OUTP", "OUTN", "VDD", "VSS"]);
