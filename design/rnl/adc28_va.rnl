/* adc28-va 0.1: generated by `python -m adcflow gen` from specs/ -- do not edit.
   DEVICE declarations and symbols of the Verilog-A modules of the behavioral
   views and testbenches (specs/va_modules.yaml). Modules with the ports of a
   block reuse that block's symbol. */
@RNL(type="header") {
  @VERSION("0.3");
  @PACKAGE(name="adc28-va", version="0.1");
  @USE-PACKAGE(name="adc28-blocks", version="0.1", path="adc28_blocks.rnl");
  @DEVICE(name="*", model="adc_comp_va", terminals=["INP", "INN", "CLKC", "OUTP", "OUTN", "AVDD", "VSS"]);
  @DEVICE(name="*", model="adc_sarlogic_va", terminals=["CONV", "OUTP", "OUTN", "CLKC", "UP12", "UP11", "UP10", "UP9", "UP8", "UP7", "UP6", "UP5", "UP4", "UP3", "UP2", "UP1", "UP0", "DN12", "DN11", "DN10", "DN9", "DN8", "DN7", "DN6", "DN5", "DN4", "DN3", "DN2", "DN1", "DN0", "D13", "D12", "D11", "D10", "D9", "D8", "D7", "D6", "D5", "D4", "D3", "D2", "D1", "D0", "RDY", "DVDD", "VSS"]);
