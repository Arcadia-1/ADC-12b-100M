/* adc28-blocks 0.1: generated by `python -m adcflow gen` from specs/ -- do not edit.
   One DEVICE declaration (terminal order = subckt port order) and one block
   symbol per block of specs/blocks/*.yaml. */
@RNL(type="header") {
  @VERSION("0.3");
  @PACKAGE(name="adc28-blocks", version="0.1");
  @DEVICE(name="*", model="adc_bootstrap", terminals=["VIN", "PHI_B", "PHI_BB", "VG", "AVDD", "VSS"]);
  @DEVICE(name="*", model="adc_cdac", terminals=["VIN", "VG", "TOP", "VCM", "VREFP", "VREFN", "PHI_S", "PHI_SB", "CONV", "DH12", "DH11", "DH10", "DH9", "DH8", "DH7", "DH6", "DH5", "DH4", "DH3", "DH2", "DH1", "DH0", "RL12", "RL11", "RL10", "RL9", "RL8", "RL7", "RL6", "RL5", "RL4", "RL3", "RL2", "RL1", "RL0", "DVDD", "VSS"]);
  @DEVICE(name="*", model="adc_clkgen", terminals=["CLK", "PHI_S", "PHI_SB", "PHI_B", "PHI_BB", "CONV", "AVDD", "VSS"]);
  @DEVICE(name="*", model="adc_comp", terminals=["INP", "INN", "CLKC", "OUTP", "OUTN", "AVDD", "VSS"]);
  @DEVICE(name="*", model="adc_ref", terminals=["VREF_IN", "VREFP", "VCM", "AVDD18", "AVDD", "VSS"]);
  @DEVICE(name="*", model="adc_sarlogic", terminals=["CONV", "OUTP", "OUTN", "CLKC", "UP12", "UP11", "UP10", "UP9", "UP8", "UP7", "UP6", "UP5", "UP4", "UP3", "UP2", "UP1", "UP0", "DN12", "DN11", "DN10", "DN9", "DN8", "DN7", "DN6", "DN5", "DN4", "DN3", "DN2", "DN1", "DN0", "D13", "D12", "D11", "D10", "D9", "D8", "D7", "D6", "D5", "D4", "D3", "D2", "D1", "D0", "RDY", "DVDD", "VSS"]);
  @DEVICE(name="*", model="adc_top", terminals=["VINP", "VINN", "CLK", "VREF_IN", "D13", "D12", "D11", "D10", "D9", "D8", "D7", "D6", "D5", "D4", "D3", "D2", "D1", "D0", "RDY", "AVDD", "DVDD", "AVDD18", "VSS"])
}

@RNL {
