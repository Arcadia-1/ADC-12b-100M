    @LINE {(-7, 2) (-6, 2)};
    (-7, 0) @PIN(terminal=2, label="PHI_B", direction="left");
    @LINE {(-7, 0) (-6, 0)};
    (-7, -2) @PIN(terminal=3, label="PHI_BB", direction="left");
    @LINE {(-7, -2) (-6, -2)};
    (7, 0) @PIN(terminal=4, label="VG", direction="right");
    @LINE {(7, 0) (6, 0)};
    (0, 5) @PIN(terminal=5, label="AVDD", direction="up");
    @LINE {(0, 5) (0, 4)};
    (0, -5) @PIN(terminal=6, label="VSS", direction="down");
    @LINE {(0, -5) (0, -4)};
    ? @TEXT("adc_bootstrap", key="model", size=0.9, bold=true) => @PLACE(0, 0.6);
    ? @TEXT("${name}", key="name", size=0.8) => @PLACE(0, -0.8)
